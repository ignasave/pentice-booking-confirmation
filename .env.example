# Every environment variable the two services read, with its default.
#
# With Docker Compose: copy this file to .env to change the booking-service tunables in the
# second block. docker-compose.yml sets the variables of the first block itself, because
# they follow from the layout of the stack, and ignores them here.
#
# Without Docker (pnpm dev): export the variables you want to change. Nothing loads this
# file automatically, and both services run on their defaults.
#
# A variable that is set must hold a usable value: an empty string is rejected at start.

# --- Set per service -------------------------------------------------------------------

# Port to listen on. Default 3000 for the booking service and 3001 for the guest simulator.
PORT=3000
# Address to bind (both services).
HOST=0.0.0.0
# Directory of the state file, bookings.json or inbox.json. One directory per service.
DATA_DIR=./data
# Booking service: base URL of the guest webhook; deliveries are posted to its /inbox.
# No default: without it bookings are accepted and nothing is sent. Compose and pnpm dev set it.
GUEST_WEBHOOK_URL=http://localhost:3001
# Guest simulator: base URL that acknowledgements are posted to.
BOOKING_SERVICE_URL=http://localhost:3000

# --- Booking service tunables ----------------------------------------------------------

# Candidate codes a booking may draw before the request fails with CODE_SPACE_EXHAUSTED.
CODE_MAX_ATTEMPTS=10
# First retry window; it doubles with every attempt.
BACKOFF_BASE_MS=1000
# Longest wait between two attempts.
BACKOFF_CAP_MS=30000
# How long one attempt waits for the guest to answer.
DELIVERY_TIMEOUT_MS=5000
# Attempts after which a delivery is flagged needsAttention.
ATTENTION_THRESHOLD=10
