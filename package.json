{
  "name": "pentice-booking-confirmation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky",
    "dev": "pnpm -r --parallel --if-present dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pentice/booking-service": "workspace:*",
    "@pentice/guest-simulator": "workspace:*",
    "@pentice/shared": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
